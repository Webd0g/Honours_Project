# ============================================================
#  .gitignore — Honours Astrophysics Project
#  Stack: Python 3.12 + LaTeX (TeX Live) + VS Code, Windows
# ============================================================


# ── Python ──────────────────────────────────────────────────

# Virtual environments — the core issue
venv/
.venv/
env/
ENV/

# Images - used for writing docs and light curves of SN
images/
images/**

# honours meetings info
honours_meetings/
honours_meetings/**

# Byte-compiled / optimised cache
__pycache__/
*.py[cod]           # covers .pyc, .pyo, .pyd
*.pyo

# Distribution / packaging artefacts
dist/
build/
*.egg-info/
*.egg

# Jupyter notebooks — checkpoints are auto-generated by JupyterLab/VS Code
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment variable files — critical: never commit credentials or API keys
.env
.env.*
secrets.yaml

# Testing
.pytest_cache/
.coverage
htmlcov/


# ── Astrophysics Data ────────────────────────────────────────

# FITS files are typically large and binary; store in a data/ dir and exclude
*.fits
*.fit
*.fts
*.fits.gz

# HDF5 data files (common in Fink broker pipelines)
*.hdf5
*.h5

# Large catalogues and photometric tables
*.csv.gz
*.parquet
*.csv

# Alerce/Fink alert packets
*.avro


# ── LaTeX ───────────────────────────────────────────────────

# Auxiliary compiler output (already in your LaTeX Workshop clean list)
*.aux
*.bbl
*.blg
*.idx
*.ind
*.lof
*.lot
*.out
*.toc
*.fls
*.log
*.fdb_latexmk
*.snm
*.nav
*.synctex.gz         # SyncTeX reverse-search index — regenerated on each build
*.synctex(busy)      # Lockfile created during active compilation

# The compiled PDF:
# Option A — exclude it (store only source, regenerate from .tex)
# *.pdf
# Option B — include it (convenient for sharing drafts without requiring LaTeX)
# Comment out the line above to track PDFs. For coursework, Option B is often
# more practical since markers may not have a LaTeX installation.


# ── VS Code ─────────────────────────────────────────────────

# Workspace settings are machine-specific — exclude unless your team shares them
.vscode/

# Exception: if you want to share recommended extensions with collaborators
# (e.g., a lab partner), you can track just the extensions file:
# !.vscode/extensions.json


# ── Windows ─────────────────────────────────────────────────

# Windows Explorer artefacts
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Windows zone identifier files (created when downloading files)
*.Zone.Identifier

# Writing & presentation content - Syncthing's responsibility
Literature_Review/
Literature_Review/**
Thesis/
Thesis/**
Portfolio/
Portfolio/**
Oral_presentation/
Oral_presentation/**

# Research Skills Class Content
Classes/
Classes/**

#logs
logs/
logs/**