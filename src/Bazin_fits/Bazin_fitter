def fit_bazin_per_band(df: pd.DataFrame) -> dict:
    """Fit a Bazin model to each band independently, returns dict of band -> fit results."""
    df = df[df["r:psfFlux"] > 0].copy()
    df = df.sort_values("r:midpointMjdTai")

    # Normalise time to start at 0 for better convergence
    t_offset = df["r:midpointMjdTai"].min()
    df["t_norm"] = df["r:midpointMjdTai"] - t_offset

    fits = {}
    for band, group in df.groupby("r:band"):
        print (f"{band}:{len(group)} detections, MJD range {group["r:midpointMjdTai"].min():.1f} - {group['r:midpointMjdTai'].max():.1f}")
        if len(group) < 5:
            print(f"  Skipping {band}-band — fewer than 5 detections")
            continue

        t = group["t_norm"].values
        f = group["r:psfFlux"].values
        f_e = group["r:psfFluxErr"].values

        # normalise the fluxes so default bounds are valid
        flux_max = f.max()
        f_norm = f/flux_max
        f_e_norm = f_e/flux_max

        # Initial guess: c=median flux, A=max-median, tau_fall=20, tau_rise=10, t0=peak time
        t0_guess = t[np.argmax(f_norm)]
        x0 = (np.median(f_norm), np.max(f_norm) - np.median(f_norm), 20, 10, t0_guess)
        bounds = [
            (-1e4, 1e4),   # c — flux offset
            (1, 1e5),      # A — amplitude in nJy
            (1, 200),      # tau_fall
            (1, 100),      # tau_rise
            (0, t.max()),  # t0
        ]

        try:
            bm = BazinModel()
            bm.fit(t, f_norm, f_e_norm, x0=x0, bounds=bounds)
            c, A, tau_fall, tau_rise, t0 = bm.p_fit
            t_peak = Bazin2011(*bm.p_fit).t_peak
            fits[band] = {
                "model": bm,
                "t_offset": t_offset,
                "t_norm": t,
                "flux": f,
                "flux_err": f_e,
                "flux_norm" : f_norm,
                "flux_max": flux_max,
                "params": {"c": c, "A": A, "tau_fall": tau_fall, "tau_rise": tau_rise, "t0": t0},
                "t_peak": t_peak + t_offset,  # convert back to MJD
                "chi2": bm.chi2_min,
            }
            print(f"  {band}-band fit: tau_rise={tau_rise:.1f}d  tau_fall={tau_fall:.1f}d  t_peak=MJD{t_peak+t_offset:.1f}  chi2={bm.chi2_min:.2f}")
        except Exception as e:
            print(f"  {band}-band fit failed: {e}")

    return fits

def plot_bazin_fits(df: pd.DataFrame, fits: dict, diaObjectId: str):
    df = df[df["r:psfFlux"] > 0].sort_values("r:midpointMjdTai")
    t_offset = df["r:midpointMjdTai"].min()

    fig, ax = plt.subplots(figsize=(11, 6))

    for band, result in fits.items():
        colour = band_colours.get(band, "black")
        t_norm = result["t_norm"]
        t_mjd = t_norm + t_offset

        # Data points
        ax.errorbar(
            t_mjd, result["flux"], yerr=result["flux_err"],
            fmt="o", color=colour, label=f"{band}-band data",
            capsize=3, markersize=5, alpha=0.8
        )

        # Bazin fit curve
        t_smooth = np.linspace(t_norm.min(), t_norm.max(), 300)
        f_smooth = result["model"].predict(t_smooth) * result["flux_max"]
        ax.plot(t_smooth + t_offset, f_smooth, "-", color=colour,
                label=f"{band}-band Bazin fit", linewidth=1.5)

        # Mark t_peak
        ax.axvline(result["t_peak"], color=colour, linestyle="-", alpha=0.4, linewidth=1)

    ax.set_xlabel("MJD (days)")
    ax.set_ylabel("Flux (nJy)")
    ax.set_title(f"Bazin fit — diaObjectId: {diaObjectId}")
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

def summarise_fits(fits: dict):
    n_params = 5  # c, A, tau_fall, tau_rise, t0
    print(f"\n{'Band':<6} {'tau_rise':>10} {'tau_fall':>10} {'ratio':>8} {'t_peak (MJD)':>14} {'chi2':>8} {'chi2_red':>10}")
    print("-" * 70)
    for band, result in fits.items():
        p = result["params"]
        ratio = p["tau_fall"] / p["tau_rise"]
        n = len(result["t_norm"])
        chi2_red = result["chi2"] / (n - n_params)
        print(f"{band:<6} {p['tau_rise']:>10.2f} {p['tau_fall']:>10.2f} {ratio:>8.2f} {result['t_peak']:>14.2f} {result['chi2']:>8.2f} {chi2_red:>10.2f}")
    print("\nSN Ia typically: tau_fall/tau_rise ~ 2-3, t_peak M_abs ~ -19.3")

